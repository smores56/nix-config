# Global git config for the GitHub mirror runs (GIT_CONFIG_GLOBAL, set by
# modules/nixos/github-backup.nix).
# Keep packs few: unpackLimit=1 stops small fetches becoming loose objects. Auto
# maintenance is off because a rewritten pack gets a new mtime and the copy-based
# mirror keys on mtime, so it would re-copy the whole pack.
[fetch]
	unpackLimit = 1
[gc]
	auto = 0
[maintenance]
	auto = false
	autoDetach = false
