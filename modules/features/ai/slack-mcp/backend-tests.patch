+func TestNoDiskCacheUserRefreshPreservesSnapshot(t *testing.T) {
+	for _, refreshed := range []bool{false, true} {
+		for _, mode := range []string{"boot-error", "user-info-error"} {
+			name := "startup/"
+			if refreshed {
+				name = "refresh/"
+			}
+			t.Run(name+mode, func(t *testing.T) {
+				root := noDiskCacheRoot(t)
+				client := newNoDiskSlackClient()
+				ap := newNoDiskProvider(client)
+				ctx := context.Background()
+				if refreshed {
+					require.NoError(t, ap.RefreshUsers(ctx))
+					require.NoError(t, ap.RefreshChannels(ctx))
+				}
+				snapshot := ap.ProvideUsersMap()
+				client.users[0].Name = "bob"
+				client.onConnect = func() {
+					require.Same(t, snapshot, ap.ProvideUsersMap())
+					require.Equal(t, refreshed, ap.usersReady.Load())
+				}
+				failure := errors.New("synthetic Slack Connect failure")
+				if mode == "boot-error" {
+					client.bootErr = failure
+				} else {
+					client.usersInfoErr = failure
+				}
+				require.ErrorIs(t, ap.RefreshUsers(ctx), failure)
+				require.Same(t, snapshot, ap.ProvideUsersMap())
+				require.Equal(t, refreshed, ap.usersReady.Load())
+				require.NotContains(t, snapshot.UsersInv, "bob")
+				if refreshed {
+					require.Equal(t, "UCONNECT", snapshot.UsersInv["external"])
+					require.Equal(t, "UAPI", snapshot.UsersInv["alice"])
+					ready, err := ap.IsReady()
+					require.NoError(t, err)
+					require.True(t, ready)
+				}
+
+				client.bootErr, client.usersInfoErr = nil, nil
+				require.NoError(t, ap.RefreshUsers(ctx))
+				require.NotSame(t, snapshot, ap.ProvideUsersMap())
+				require.Equal(t, "UAPI", ap.ProvideUsersMap().UsersInv["bob"])
+				require.Equal(t, "UCONNECT", ap.ProvideUsersMap().UsersInv["external"])
+				require.True(t, ap.usersReady.Load())
+				client.onConnect = nil
+				client.usersInfoErr = failure
+				client.users = append(client.users, slack.User{ID: "UCONNECT", Name: "direct"})
+				require.NoError(t, ap.RefreshUsers(ctx))
+				require.Equal(t, "UCONNECT", ap.ProvideUsersMap().UsersInv["direct"])
+				require.NotContains(t, ap.ProvideUsersMap().UsersInv, "external")
+				require.Empty(t, noDiskEntries(t, root))
+			})
+		}
+	}
+}
