+func TestNoDiskCacheEnterpriseChannelRefreshPreservesSnapshot(t *testing.T) {
+	for _, mode := range []string{"first-page-api-error", "second-page-api-error", "second-page-http-error"} {
+		t.Run(mode, func(t *testing.T) {
+			root := noDiskCacheRoot(t)
+			ctx := context.Background()
+			ap := newNoDiskProvider(newNoDiskSlackClient())
+			require.NoError(t, ap.RefreshUsers(ctx))
+			fail := false
+			calls := 0
+			failure := errors.New("synthetic HTTP failure")
+			httpClient := noDiskHTTPClient(func(req *http.Request) (*http.Response, error) {
+				body := `{"ok":true}`
+				switch req.URL.Path {
+				case "/api/client.userBoot":
+					body = `{"ok":true,"channels":[{"id":"CEDGE","name":"edge","name_normalized":"edge"}]}`
+				case "/api/im.list", "/api/search.modules.channels", "/api/client.counts":
+				case "/api/conversations.list":
+					calls++
+					if err := req.ParseForm(); err != nil {
+						return nil, err
+					}
+					cursor := req.Form.Get("cursor")
+					if fail && (mode == "first-page-api-error" || cursor == "next") {
+						if mode == "second-page-http-error" {
+							return nil, failure
+						}
+						body = `{"ok":false,"error":"synthetic_page_failure"}`
+					} else if cursor == "" {
+						body = `{"ok":true,"channels":[{"id":"CEDGE","name":"duplicate","name_normalized":"duplicate"},{"id":"CSTD1","name":"standard-one","name_normalized":"standard-one"}],"response_metadata":{"next_cursor":"next"}}`
+					} else if cursor == "next" {
+						body = `{"ok":true,"channels":[{"id":"CSTD2","name":"standard-two","name_normalized":"standard-two"}]}`
+					} else {
+						return nil, errors.New("unexpected cursor: " + cursor)
+					}
+				default:
+					return nil, errors.New("unexpected request: " + req.URL.Path)
+				}
+				return &http.Response{
+					StatusCode: http.StatusOK,
+					Header:     http.Header{"Content-Type": {"application/json"}},
+					Body:       io.NopCloser(strings.NewReader(body)),
+					Request:    req,
+				}, nil
+			})
+			info := &slack.AuthTestResponse{URL: "https://workspace.invalid/", TeamID: "TTEST"}
+			edgeClient, err := edge.NewWithInfo(info, auth.ValueAuth{}, edge.OptionHTTPClient(httpClient))
+			require.NoError(t, err)
+			client := &MCPSlackClient{
+				slackClient:  slack.New("synthetic", slack.OptionAPIURL(info.URL+"api/"), slack.OptionHTTPClient(httpClient)),
+				edgeClient:   edgeClient,
+				isEnterprise: true,
+			}
+			ap.client = client
+			require.NoError(t, ap.RefreshChannels(ctx))
+			require.Equal(t, 2, calls)
+			snapshot := ap.ProvideChannelsMaps()
+			require.Len(t, snapshot.Channels, 3)
+			require.Equal(t, "CEDGE", snapshot.ChannelsInv["#edge"])
+			require.Equal(t, "CSTD2", snapshot.ChannelsInv["#standard-two"])
+
+			fail = true
+			err = ap.ForceRefreshChannels(ctx)
+			if mode == "second-page-http-error" {
+				require.ErrorIs(t, err, failure)
+			} else {
+				require.EqualError(t, err, "synthetic_page_failure")
+			}
+			require.Same(t, snapshot, ap.ProvideChannelsMaps())
+			require.Equal(t, "CSTD2", ap.ProvideChannelsMaps().ChannelsInv["#standard-two"])
+			ready, err := ap.IsReady()
+			require.NoError(t, err)
+			require.True(t, ready)
+			require.False(t, client.edgeFailed)
+
+			channels, cursor, err := client.GetConversationsContext(ctx, &slack.GetConversationsParameters{Types: AllChanTypes})
+			require.Error(t, err)
+			require.Nil(t, channels)
+			require.Empty(t, cursor)
+			fresh := newNoDiskProvider(newNoDiskSlackClient())
+			fresh.client = client
+			require.Error(t, fresh.RefreshChannels(ctx))
+			require.False(t, fresh.channelsReady.Load())
+			require.Empty(t, fresh.ProvideChannelsMaps().Channels)
+
+			fail = false
+			require.NoError(t, ap.ForceRefreshChannels(ctx))
+			require.NotSame(t, snapshot, ap.ProvideChannelsMaps())
+			require.Equal(t, snapshot, ap.ProvideChannelsMaps())
+			require.Empty(t, noDiskEntries(t, root))
+		})
+	}
+}
