+func TestNoDiskCacheChannelRefreshPreservesSnapshot(t *testing.T) {
+	for _, mode := range []string{"api-error", "later-page-error", "later-page-canceled", "empty"} {
+		t.Run(mode, func(t *testing.T) {
+			root := noDiskCacheRoot(t)
+			t.Setenv("SLACK_MCP_MIN_REFRESH_INTERVAL", "1h")
+			client := newNoDiskSlackClient()
+			ap := newNoDiskProvider(client)
+			require.NoError(t, ap.RefreshUsers(context.Background()))
+			require.NoError(t, ap.RefreshChannels(context.Background()))
+			snapshot := ap.ProvideChannelsMaps()
+			require.Equal(t, "CAPI", snapshot.ChannelsInv["#general"])
+			require.Equal(t, "DAPI", snapshot.ChannelsInv["@alice"])
+			require.Len(t, snapshot.Channels, 2)
+
+			channels := client.channels
+			channels[0].NameNormalized = "updated"
+			failure := errors.New("Slack unavailable")
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			switch mode {
+			case "api-error":
+				client.channelsErr = failure
+			case "later-page-error", "later-page-canceled":
+				if mode == "later-page-canceled" {
+					failure = context.Canceled
+				}
+				client.channelPage = func(ctx context.Context, params *slack.GetConversationsParameters) ([]slack.Channel, string, error) {
+					require.NotEmpty(t, params.Types)
+					if params.Cursor == "" {
+						if mode == "later-page-canceled" {
+							cancel()
+						}
+						return channels[:1], "next", nil
+					}
+					require.Equal(t, "next", params.Cursor)
+					return nil, "", failure
+				}
+			case "empty":
+				client.channels = nil
+				failure = nil
+			}
+
+			err := ap.ForceRefreshChannels(ctx)
+			if failure != nil {
+				require.ErrorIs(t, err, failure)
+			} else {
+				require.NoError(t, err)
+			}
+			require.Same(t, snapshot, ap.ProvideChannelsMaps())
+			ready, err := ap.IsReady()
+			require.NoError(t, err)
+			require.True(t, ready)
+			require.Equal(t, "CAPI", ap.ProvideChannelsMaps().ChannelsInv["#general"])
+			require.Equal(t, "DAPI", ap.ProvideChannelsMaps().ChannelsInv["@alice"])
+			require.NotContains(t, ap.ProvideChannelsMaps().ChannelsInv, "#updated")
+			calls := client.channelCalls
+			require.ErrorIs(t, ap.ForceRefreshChannels(context.Background()), ErrRefreshRateLimited)
+			require.Equal(t, calls, client.channelCalls)
+
+			require.Nil(t, ap.GetChannels(ctx, []string{"public_channel"}))
+			require.Nil(t, ap.GetChannelsType(ctx, "public_channel"))
+			require.Same(t, snapshot, ap.ProvideChannelsMaps())
+			client.channels, client.channelsErr, client.channelPage = channels, nil, nil
+			ap.lastForcedChannelsRefresh = time.Now().Add(-2 * time.Hour)
+			require.NoError(t, ap.ForceRefreshChannels(context.Background()))
+			require.NotSame(t, snapshot, ap.ProvideChannelsMaps())
+			require.Equal(t, "CAPI", ap.ProvideChannelsMaps().ChannelsInv["#updated"])
+			require.Equal(t, "DAPI", ap.ProvideChannelsMaps().ChannelsInv["@alice"])
+			require.NotContains(t, ap.ProvideChannelsMaps().ChannelsInv, "#general")
+			require.Equal(t, "CAPI", snapshot.ChannelsInv["#general"])
+			require.Empty(t, noDiskEntries(t, root))
+		})
+	}
+}
