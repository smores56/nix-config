--- /dev/null
+++ b/pkg/provider/api_no_disk_cache_test.go
@@ -0,0 +1,527 @@
+package provider
+
+import (
+	"context"
+	"errors"
+	"io"
+	"io/fs"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/korotovsky/slack-mcp-server/pkg/provider/edge"
+	"github.com/rusq/slackdump/v3/auth"
+	"github.com/slack-go/slack"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"golang.org/x/time/rate"
+)
+
+type noDiskSlackClient struct {
+	SlackAPI
+	users        []slack.User
+	channels     []slack.Channel
+	usersErr     error
+	channelsErr  error
+	bootErr      error
+	usersInfoErr error
+	onConnect    func()
+	usersCalls   int
+	channelCalls int
+	channelPage  func(context.Context, *slack.GetConversationsParameters) ([]slack.Channel, string, error)
+}
+
+func (m *noDiskSlackClient) GetUsersContext(ctx context.Context, options ...slack.GetUsersOption) ([]slack.User, error) {
+	m.usersCalls++
+	return m.users, m.usersErr
+}
+
+func (m *noDiskSlackClient) ClientUserBoot(ctx context.Context) (*edge.ClientUserBootResponse, error) {
+	if m.onConnect != nil {
+		m.onConnect()
+	}
+	return &edge.ClientUserBootResponse{IMs: []edge.IM{{User: "UCONNECT", IsExtShared: true}}}, m.bootErr
+}
+
+func (m *noDiskSlackClient) GetUsersInfo(users ...string) (*[]slack.User, error) {
+	result := []slack.User{{ID: "UCONNECT", Name: "external"}}
+	return &result, m.usersInfoErr
+}
+
+func (m *noDiskSlackClient) GetConversationsContext(ctx context.Context, params *slack.GetConversationsParameters) ([]slack.Channel, string, error) {
+	m.channelCalls++
+	if m.channelPage != nil {
+		return m.channelPage(ctx, params)
+	}
+	return m.channels, "", m.channelsErr
+}
+
+func newNoDiskSlackClient() *noDiskSlackClient {
+	return &noDiskSlackClient{
+		users: []slack.User{{ID: "UAPI", Name: "alice", RealName: "Alice"}},
+		channels: []slack.Channel{
+			{GroupConversation: slack.GroupConversation{
+				Conversation: slack.Conversation{ID: "CAPI", NameNormalized: "general"},
+				Name:         "general",
+			}},
+			{GroupConversation: slack.GroupConversation{
+				Conversation: slack.Conversation{ID: "DAPI", IsIM: true, User: "UAPI"},
+			}},
+		},
+	}
+}
+
+func newNoDiskProvider(client *noDiskSlackClient) *ApiProvider {
+	ap := newWithXOXP("stdio", auth.ValueAuth{}, zap.NewNop())
+	ap.client = client
+	ap.rateLimiter = rate.NewLimiter(rate.Inf, 1)
+	return ap
+}
+
+func noDiskCacheRoot(t *testing.T) string {
+	t.Helper()
+	root := t.TempDir()
+	t.Setenv("HOME", filepath.Join(root, "home"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(root, "xdg"))
+	t.Setenv("SLACK_MCP_XOXP_TOKEN", "demo")
+	t.Setenv("SLACK_MCP_XOXB_TOKEN", "")
+	t.Setenv("SLACK_MCP_XOXC_TOKEN", "demo")
+	t.Setenv("SLACK_MCP_XOXD_TOKEN", "demo")
+	t.Setenv("SLACK_MCP_MIN_REFRESH_INTERVAL", "0")
+	t.Setenv("SLACK_MCP_USERS_CACHE", "")
+	t.Setenv("SLACK_MCP_CHANNELS_CACHE", "")
+	t.Chdir(root)
+	return root
+}
+
+func noDiskEntries(t *testing.T, root string) map[string]string {
+	t.Helper()
+	entries := make(map[string]string)
+	require.NoError(t, filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if path == root {
+			return nil
+		}
+		if entry.IsDir() {
+			entries[path+"/"] = ""
+			return nil
+		}
+		data, err := os.ReadFile(path)
+		entries[path] = string(data)
+		return err
+	}))
+	return entries
+}
+
+func seedNoDiskFiles(t *testing.T, root string) {
+	t.Helper()
+	cacheDir, err := os.UserCacheDir()
+	require.NoError(t, err)
+	for _, dir := range []string{root, filepath.Join(cacheDir, "slack-mcp-server")} {
+		require.NoError(t, os.MkdirAll(dir, 0700))
+		for _, prefix := range []string{"", "demo_"} {
+			require.NoError(t, os.WriteFile(filepath.Join(dir, prefix+"users_cache.json"), []byte(`[{"id":"UDISK","name":"disk"}]`), 0600))
+			require.NoError(t, os.WriteFile(filepath.Join(dir, prefix+"channels_cache_v2.json"), []byte(`[{"id":"CDISK","name":"#disk"}]`), 0600))
+		}
+	}
+	require.NoError(t, os.MkdirAll(filepath.Join(root, "overrides"), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "overrides", "users.json"), []byte(`[{"id":"UDISK","name":"disk"}]`), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "overrides", "channels.json"), []byte(`[{"id":"CDISK","name":"#disk"}]`), 0600))
+}
+
+func TestNoDiskCacheStartupAndRefresh(t *testing.T) {
+	constructors := map[string]func(string, auth.ValueAuth, *zap.Logger) *ApiProvider{
+		"oauth":   newWithXOXP,
+		"session": newWithXOXC,
+	}
+	for name, constructor := range constructors {
+		for _, mode := range []struct {
+			name      string
+			overrides bool
+			existing  bool
+			noHome    bool
+		}{
+			{name: "default"},
+			{name: "overrides", overrides: true},
+			{name: "existing", existing: true},
+			{name: "existing-overrides", overrides: true, existing: true},
+			{name: "no-home", noHome: true},
+		} {
+			t.Run(name+"/"+mode.name, func(t *testing.T) {
+				root := noDiskCacheRoot(t)
+				if mode.overrides {
+					t.Setenv("SLACK_MCP_USERS_CACHE", filepath.Join(root, "overrides", "users.json"))
+					t.Setenv("SLACK_MCP_CHANNELS_CACHE", filepath.Join(root, "overrides", "channels.json"))
+				}
+				if mode.existing {
+					seedNoDiskFiles(t, root)
+				}
+				if mode.noHome {
+					t.Setenv("HOME", "")
+					t.Setenv("XDG_CACHE_HOME", "")
+				}
+				before := noDiskEntries(t, root)
+				ap := constructor("stdio", auth.ValueAuth{}, zap.NewNop())
+				require.Empty(t, ap.ProvideUsersMap().Users)
+				require.Empty(t, ap.ProvideChannelsMaps().Channels)
+				ready, err := ap.IsReady()
+				require.False(t, ready)
+				require.ErrorIs(t, err, ErrUsersNotReady)
+				require.Equal(t, before, noDiskEntries(t, root))
+
+				client := newNoDiskSlackClient()
+				ap.client = client
+				ap.rateLimiter = rate.NewLimiter(rate.Inf, 1)
+				ctx := context.Background()
+				require.NoError(t, ap.RefreshUsers(ctx))
+				ready, err = ap.IsReady()
+				require.False(t, ready)
+				require.ErrorIs(t, err, ErrChannelsNotReady)
+				require.NoError(t, ap.RefreshChannels(ctx))
+				require.Equal(t, 1, client.usersCalls)
+				require.Equal(t, 1, client.channelCalls)
+				users := ap.ProvideUsersMap()
+				channels := ap.ProvideChannelsMaps()
+				require.Equal(t, "UAPI", users.UsersInv["alice"])
+				require.Equal(t, "UCONNECT", users.UsersInv["external"])
+				require.Equal(t, "CAPI", channels.ChannelsInv["#general"])
+				require.Equal(t, "DAPI", channels.ChannelsInv["@alice"])
+				require.NotContains(t, users.Users, "UDISK")
+				require.NotContains(t, channels.Channels, "CDISK")
+				ready, err = ap.IsReady()
+				require.NoError(t, err)
+				require.True(t, ready)
+				require.Equal(t, before, noDiskEntries(t, root))
+
+				client.users[0].Name = "bob"
+				client.channels[0].NameNormalized = "updated"
+				require.NoError(t, ap.ForceRefreshUsers(ctx))
+				require.NoError(t, ap.ForceRefreshChannels(ctx))
+				require.Equal(t, 2, client.usersCalls)
+				require.Equal(t, 2, client.channelCalls)
+				require.Equal(t, "UAPI", ap.ProvideUsersMap().UsersInv["bob"])
+				require.Equal(t, "UCONNECT", ap.ProvideUsersMap().UsersInv["external"])
+				require.NotContains(t, ap.ProvideUsersMap().UsersInv, "alice")
+				require.Equal(t, "CAPI", ap.ProvideChannelsMaps().ChannelsInv["#updated"])
+				require.Equal(t, "DAPI", ap.ProvideChannelsMaps().ChannelsInv["@bob"])
+				require.NotContains(t, ap.ProvideChannelsMaps().ChannelsInv, "#general")
+				require.Equal(t, "UAPI", users.UsersInv["alice"])
+				require.Equal(t, "CAPI", channels.ChannelsInv["#general"])
