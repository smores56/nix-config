{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom", "dom.iterable", "es2022"]
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-run --allow-env scripts/build.ts",
    "test": "deno test --allow-read=. --allow-env",
    "typecheck": "deno check $(find src scripts -name '*.ts' -not -path '*/node_modules/*')",
    "blob": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net scripts/blob.ts",
    "sentinel": "deno run --allow-read --allow-env --allow-net scripts/sentinel.ts",
    "smoke": "deno run --allow-read --allow-run --allow-net --allow-env scripts/smoke.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["dist/", "node_modules/", "test-fixtures/"]
  },
  "lint": {
    "exclude": ["dist/", "node_modules/", "test-fixtures/"]
  }
}
