+/// Read exactly `buf.len()` bytes, giving up as soon as SIGINT was caught.
+/// The read timeout keeps the flag observable even when a signal does not
+/// interrupt this thread's blocking read.
+fn read_exact_interruptible(stream: &mut Stream, buf: &mut [u8]) -> Result<(), ErrType> {
+    let mut filled = 0;
+    while filled < buf.len() {
+        if interrupt::interrupted() {
+            return Err(RsshErr::Interrupted.into_ptr());
+        }
+        match stream.read(&mut buf[filled..]) {
+            Ok(0) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::UnexpectedEof,
+                    "SSH-agent closed the connection",
+                )
+                .into())
+            }
+            Ok(n) => filled += n,
+            Err(e) => match e.kind() {
+                // The guard sets a short read timeout so an interrupt stored
+                // by the handler becomes visible on the next pass.  Without
+                // it, a timeout is the original blocking error.
+                io::ErrorKind::Interrupted | io::ErrorKind::WouldBlock | io::ErrorKind::TimedOut => {
+                    if !interrupt::armed() && e.kind() != io::ErrorKind::Interrupted {
+                        return Err(e.into());
+                    }
+                }
+                _ => return Err(e.into()),
+            },
+        }
+    }
+    Ok(())
+}
+
+/// The agent process and its uid behind a UNIX socket.  None for a TCP agent
+/// and for a forwarded agent, where the touch happens on another host.
+#[cfg(target_os = "linux")]
+fn peer_cred(stream: &Stream) -> Option<(libc::pid_t, libc::uid_t)> {
+    use std::os::unix::io::AsRawFd;
+
+    if let Stream::Unix(sock) = stream {
+        let mut cred: libc::ucred = unsafe { std::mem::zeroed() };
+        let mut len = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+        let rc = unsafe {
+            libc::getsockopt(
+                sock.as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_PEERCRED,
+                &mut cred as *mut _ as *mut libc::c_void,
+                &mut len,
+            )
+        };
+        if rc == 0 && cred.pid > 0 {
+            return Some((cred.pid, cred.uid));
+        }
+    }
+    None
+}
+
+#[cfg(not(target_os = "linux"))]
+fn peer_cred(_: &Stream) -> Option<(libc::pid_t, libc::uid_t)> {
+    None
+}
+
+/// ssh-sk-helper processes currently waiting under `agent_pid` as `uid`.
+#[cfg(target_os = "linux")]
+fn pending_helpers(agent_pid: libc::pid_t, uid: libc::uid_t) -> Vec<libc::pid_t> {
+    let mut pids = Vec::new();
+    let entries = match std::fs::read_dir("/proc") {
+        Ok(entries) => entries,
+        Err(e) => {
+            warn!("Failed to scan /proc for ssh-sk-helper: {}", e);
+            return pids;
+        }
+    };
+    for entry in entries.flatten() {
+        let pid: libc::pid_t = match entry.file_name().to_str().and_then(|n| n.parse().ok()) {
+            Some(pid) => pid,
+            None => continue,
+        };
+        let status = match std::fs::read_to_string(format!("/proc/{}/status", pid)) {
+            Ok(status) => status,
+            Err(_) => continue,
+        };
+        if helper_matches(&status, agent_pid, uid) {
+            pids.push(pid);
+        }
+    }
+    pids
+}
+
+#[cfg(not(target_os = "linux"))]
+fn pending_helpers(_: libc::pid_t, _: libc::uid_t) -> Vec<libc::pid_t> {
+    Vec::new()
+}
+
+#[cfg(target_os = "linux")]
+fn helper_matches(status: &str, agent_pid: libc::pid_t, uid: libc::uid_t) -> bool {
+    let name = status.lines().find_map(|l| l.strip_prefix("Name:\t"));
+    let ppid = status
+        .lines()
+        .find_map(|l| l.strip_prefix("PPid:\t"))
+        .and_then(|v| v.trim().parse::<libc::pid_t>().ok());
+    let owner = status
+        .lines()
+        .find_map(|l| l.strip_prefix("Uid:\t"))
+        .and_then(|v| v.split_whitespace().next())
+        .and_then(|v| v.parse::<libc::uid_t>().ok());
+    name == Some("ssh-sk-helper") && ppid == Some(agent_pid) && owner == Some(uid)
+}
+
+/// ssh-agent signs synchronously, so an abandoned request keeps the agent in
+/// waitpid and unresponsive.  Kill only the helper started for this request:
+/// the agent serves one client at a time, so anything already waiting under it
+/// belongs to a concurrent request.  SIGKILL cannot send the CTAP cancel, so
+/// the key may want one more tap before accepting a fresh assertion.
+#[cfg(target_os = "linux")]
+fn kill_pending_helpers(agent_pid: libc::pid_t, uid: libc::uid_t, existing: &[libc::pid_t]) {
+    for pid in pending_helpers(agent_pid, uid) {
+        if existing.contains(&pid) {
+            continue;
+        }
+        debug!("Killing pending ssh-sk-helper {}", pid);
+        unsafe {
+            libc::kill(pid, libc::SIGKILL);
+        }
+    }
+}
+
+#[cfg(not(target_os = "linux"))]
+fn kill_pending_helpers(_: libc::pid_t, _: libc::uid_t, _: &[libc::pid_t]) {}
