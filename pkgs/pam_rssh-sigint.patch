@@ -0,0 +1,91 @@
+//! Cancellable waits around the agent signature request.
+//!
+//! sudo treats PAM authentication as a critical section: it blocks SIGINT and
+//! SIGQUIT for the whole stack and only unblocks them around its own password
+//! prompt.  A touch request inside an auth module therefore cannot be
+//! cancelled.  This guard unblocks SIGINT for the duration of the signature
+//! request only, catches it, and exposes the flag to the agent client, which
+//! aborts the read and drops the pending ssh-sk-helper.
+
+use log::*;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+
+/// How long a blocking agent read may wait before re-checking the flag.
+pub const READ_POLL: Duration = Duration::from_millis(100);
+
+static INSTALLED: AtomicBool = AtomicBool::new(false);
+static INTERRUPTED: AtomicBool = AtomicBool::new(false);
+
+extern "C" fn handle_sigint(_: libc::c_int) {
+    INTERRUPTED.store(true, Ordering::SeqCst);
+}
+
+pub struct SigintGuard {
+    old_action: libc::sigaction,
+    old_mask: libc::sigset_t,
+    active: bool,
+}
+
+impl SigintGuard {
+    pub fn install() -> SigintGuard {
+        let mut guard = SigintGuard {
+            old_action: unsafe { std::mem::zeroed() },
+            old_mask: unsafe { std::mem::zeroed() },
+            active: false,
+        };
+        INTERRUPTED.store(false, Ordering::SeqCst);
+        unsafe {
+            let mut action: libc::sigaction = std::mem::zeroed();
+            let handler: extern "C" fn(libc::c_int) = handle_sigint;
+            action.sa_sigaction = handler as *const () as libc::sighandler_t;
+            action.sa_flags = 0;
+            libc::sigemptyset(&mut action.sa_mask);
+            if libc::sigaction(libc::SIGINT, &action, &mut guard.old_action) != 0 {
+                warn!(
+                    "Failed to install SIGINT handler: {}",
+                    std::io::Error::last_os_error()
+                );
+                return guard;
+            }
+            let mut set: libc::sigset_t = std::mem::zeroed();
+            libc::sigemptyset(&mut set);
+            libc::sigaddset(&mut set, libc::SIGINT);
+            if libc::sigprocmask(libc::SIG_UNBLOCK, &set, &mut guard.old_mask) != 0 {
+                warn!(
+                    "Failed to unblock SIGINT: {}",
+                    std::io::Error::last_os_error()
+                );
+                libc::sigaction(libc::SIGINT, &guard.old_action, std::ptr::null_mut());
+                return guard;
+            }
+            guard.active = true;
+            INSTALLED.store(true, Ordering::SeqCst);
+        }
+        guard
+    }
+}
+
+impl Drop for SigintGuard {
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        unsafe {
+            // Re-block before returning the handler to sudo so an interrupt
+            // cannot be delivered to, and swallowed by, sudo's own handler.
+            libc::sigprocmask(libc::SIG_SETMASK, &self.old_mask, std::ptr::null_mut());
+            libc::sigaction(libc::SIGINT, &self.old_action, std::ptr::null_mut());
+        }
+        INSTALLED.store(false, Ordering::SeqCst);
+    }
+}
+
+pub fn interrupted() -> bool {
+    INSTALLED.load(Ordering::SeqCst) && INTERRUPTED.load(Ordering::SeqCst)
+}
+
+/// Whether a guard is active, i.e. whether an interrupt is being watched for.
+pub fn armed() -> bool {
+    INSTALLED.load(Ordering::SeqCst)
+}
