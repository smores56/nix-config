+#[cfg(all(test, unix))]
+mod interrupt_tests {
+    use super::*;
+    use std::os::unix::net::UnixStream;
+
+    #[test]
+    fn sigint_aborts_agent_read() {
+        let (side, _peer) = UnixStream::pair().unwrap();
+        side.set_read_timeout(Some(interrupt::READ_POLL)).unwrap();
+        let mut stream = Stream::from(side);
+        let guard = interrupt::SigintGuard::install();
+        unsafe {
+            libc::raise(libc::SIGINT);
+        }
+        assert!(interrupt::interrupted());
+        let mut buf = [0u8; 4];
+        let err = read_exact_interruptible(&mut stream, &mut buf).unwrap_err();
+        assert!(matches!(
+            err.downcast_ref::<RsshErr>(),
+            Some(RsshErr::Interrupted)
+        ));
+        drop(guard);
+        assert!(!interrupt::interrupted());
+    }
+}
